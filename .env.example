OPENAI_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
TEMPERATURE=0.0
MAX_TOKENS=1000
TOP_K=5
SCORE_THRESHOLD=0.5
CHROMA_PERSIST_DIR=./data/processed/chroma_db
CHUNK_SIZE=300
CHUNK_OVERLAP=30
USE_OPENAI_EMBEDDINGS=false
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ===== LLM Google (alternative au local ; utilisé en priorité si activé) =====
# USE_GOOGLE_LLM=true active Gemini pour la génération. Laisser false en mode
# hors ligne (le chat utilise alors le LLM local Qwen).
USE_GOOGLE_LLM=false
GOOGLE_API_KEY=
GOOGLE_LLM_MODEL=gemini-2.0-flash

# ===== Mode hors ligne (recommandé) =====
USE_LOCAL_LLM=true
LOCAL_LLM_MODEL_PATH=models/qwen2.5-1.5b-instruct-q4_k_m.gguf
LOCAL_LLM_CONTEXT=8192
LOCAL_LLM_MAX_TOKENS=512
LOCAL_JUDGE_MAX_TOKENS=256
LOCAL_LLM_BATCH_SIZE=512
LOCAL_LLM_THREADS=8
